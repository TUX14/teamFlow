# ---------------------------------------------------------------------------
# Dados sensíveis gerados em runtime — NUNCA commitar
# ---------------------------------------------------------------------------
data/
received/
uploads/

# Defesa em profundidade: ignora chaves e bancos em qualquer lugar da árvore,
# mesmo que alguém mova ou copie fora de data/
*.key
*.db
*.sqlite
*.sqlite3

# Logs e variáveis de ambiente
*.log
.env
.env.*

# Textual / UI cache
.textual/

# ---------------------------------------------------------------------------
# Claude Code — config local de máquina (permissões, segredos)
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw

